# Copy this file to .env.local and fill in your own values (.env.local is not committed).

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Demo mode only (no Supabase keys). With a database, the staff_users table decides.
NEXT_PUBLIC_PROVOST_EMAILS=provost@example.com
NEXT_PUBLIC_MUNSHI_EMAILS=munshi@example.com

# Mail address behind "Contact Admin" on the login page
NEXT_PUBLIC_ADMIN_CONTACT=admin@example.com